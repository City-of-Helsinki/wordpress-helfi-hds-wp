{
  "apiVersion": 3,
  "title": "Helsinki - Custom Post Type Filter Listing",
  "description": "Display a filterable list of custom post type posts.",
  "name": "hds-wp/content-filter-list",
  "icon": "list-view",
  "textdomain": "hds-wp",
  "category": "hds-wp",
  "supports": {
    "anchor": true
  },
  "attributes": {
    "anchor": {
      "type": "string",
      "default": ""
    },
    "title": {
      "type": "string",
      "default": ""
    },
    "description": {
      "type": "string",
      "default": ""
    },
    "postType": {
      "type": "string",
      "default": ""
    },
    "filterTaxonomies": {
      "type": "array",
      "default": []
    },
    "entryElements": {
      "type": "array",
      "default": []
    }
  },
  "render_callback": "hds_wp_render_content_filter_list",
  "style": [ "helsinki-wp-blocks", "file:./style.css" ],
  "editorStyle": [ "file:./editor.css" ],
  "editorScript": "file:./block.js",
  "script": [ "helsinki-wp-hds-content-list-filter" ]
}
